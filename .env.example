# Copia este archivo a .env y ajústalo.

# Zona horaria (afecta a los horarios del control parental). Ej.: America/Mexico_City, Europe/Madrid
TZ=UTC

# Contraseña del panel. Déjala vacía para crearla en el primer acceso web.
NETPING_PASSWORD=

# Puertos
NETPING_WEB_PORT=8080
NETPING_DNS_PORT=53

# Opcional — perfil "cloudflared" (Cloudflare Tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# Opcional — perfil "ddns" (DuckDNS)
DUCKDNS_SUBDOMAINS=
DUCKDNS_TOKEN=
